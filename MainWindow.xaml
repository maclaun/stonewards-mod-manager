<Window x:Class="StoneWardsModManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StoneWards Addons Mod Manager" Height="650" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#18181B" Foreground="#F4F4F5">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#27272A" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="StoneWards Mod Manager" FontSize="22" FontWeight="Bold" Foreground="#38BDF8"/>
                    <TextBlock Text="Официальный менеджер модификаций сообщества StoneWards Addons" FontSize="13" Foreground="#A1A1AA" Margin="0,4,0,0"/>
                </StackPanel>

                <Button Grid.Column="1" Content="🚀 Запустить StoneWards" Click="LaunchGame_Click" 
                        Background="#0284C7" Foreground="White" FontSize="14" FontWeight="Bold" 
                        Padding="16,8" Cursor="Hand" BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="6"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>

        <!-- Game Path Selector -->
        <Border Grid.Row="1" Background="#27272A" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Папка с игрой:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" Foreground="#E4E4E7"/>
                <TextBox x:Name="TxtGamePath" Grid.Column="1" VerticalAlignment="Center" Background="#18181B" Foreground="#F4F4F5" BorderBrush="#3F3F46" Padding="6"/>
                <Button Grid.Column="2" Content="Обзор..." Click="BrowsePath_Click" Margin="10,0,5,0" Padding="12,6" Background="#3F3F46" Foreground="White" BorderThickness="0"/>
                <Button Grid.Column="3" Content="Установить BepInEx" Click="InstallBepInEx_Click" Margin="5,0,0,0" Padding="12,6" Background="#16A34A" Foreground="White" FontWeight="SemiBold" BorderThickness="0"/>
            </Grid>
        </Border>

        <!-- Mod List Grid -->
        <Border Grid.Row="2" Background="#27272A" CornerRadius="8" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Доступные модификации (GitHub Releases)" FontSize="16" FontWeight="Bold" Foreground="#F4F4F5"/>
                    <Button Content="🔄 Обновить список" Click="RefreshMods_Click" HorizontalAlignment="Right" Background="Transparent" Foreground="#38BDF8" BorderThickness="0" Cursor="Hand" FontWeight="SemiBold"/>
                </Grid>

                <DataGrid x:Name="GridMods" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="#18181B" Foreground="#F4F4F5" RowBackground="#18181B" AlternatingRowBackground="#27272A" AlternationCount="2"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#3F3F46" HeadersVisibility="Column" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="Включен" Binding="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                        <DataGridTextColumn Header="Название мода" Binding="{Binding Name}" Width="200" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Версия" Binding="{Binding Version}" Width="90" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Автор" Binding="{Binding Author}" Width="140" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Действие" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding ActionText}" Click="DownloadOrToggleMod_Click" 
                                            Background="#0EA5E9" Foreground="White" Padding="8,4" BorderThickness="0" Cursor="Hand"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Status Footer -->
        <StatusBar Grid.Row="3" Background="Transparent" Margin="0,10,0,0" Foreground="#A1A1AA">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="Статус: Готов к работе."/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
